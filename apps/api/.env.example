# Copy this file to .env and set a PostgreSQL connection string and unique secrets.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mercur_db
REDIS_URL=redis://localhost:6379
STORE_CORS=http://localhost:5173
ADMIN_CORS=http://localhost:9000
VENDOR_CORS=http://localhost:5173
AUTH_CORS=http://localhost:5173,http://localhost:9000
JWT_SECRET=replace-with-a-random-secret
COOKIE_SECRET=replace-with-a-different-random-secret
FILE_BACKEND_URL=http://localhost:9000/static
NODE_ENV=development
MARKETPLACE_DEFAULT_TRANSACTION_MODE=checkout
MARKETPLACE_REGION_NAME=
MARKETPLACE_CURRENCY_CODE=
MARKETPLACE_COUNTRIES=
MARKETPLACE_PAYMENT_PROVIDER_IDS=pp_external_sinpe_external_sinpe
