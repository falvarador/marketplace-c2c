{
  "compilerOptions": {
    "target": "ES2021",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "outDir": ".medusa/server",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["medusa-config.ts", "src/**/*.ts"],
  "exclude": ["node_modules", ".medusa"]
}
